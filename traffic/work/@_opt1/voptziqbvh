library verilog;
use verilog.vl_types.all;
entity country_fsm is
    port(
        clk             : in     vl_logic;
        rst_n           : in     vl_logic;
        car             : in     vl_logic;
        \Timeout\       : in     vl_logic;
        timeout         : in     vl_logic;
        enable_h        : out    vl_logic;
        enable_n        : in     vl_logic;
        start_n         : out    vl_logic;
        light_n         : out    vl_logic_vector(2 downto 0)
    );
end country_fsm;
